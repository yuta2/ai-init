#!/usr/bin/env bash
set -euo pipefail

SHARED_HOME="$HOME/.ai-dev-rules"
RUNTIME_HOME="$SHARED_HOME/runtime"

# name|file|marker — the single source of truth for which adapters exist.
ADAPTERS="codex|AGENTS.md|CODEX
pi-agent|AGENTS.md|PI
deepseek-harness|AGENTS.md|DSH
claude-code|CLAUDE.md|CLAUDE"

usage() {
  cat <<'HELP'
ai-init - initialize shared AI engineering context for the current project

Usage:
  ai-init              Initialize or update project adapters
  ai-init --status     Show initialization status
  ai-init --remove     Remove only managed project adapter blocks
  ai-init --help       Show this help

Behavior:
  - Uses the Git repository root when inside a Git repo
  - Otherwise uses the current directory
  - Never overwrites existing AGENTS.md or CLAUDE.md
  - Backs up each touched file once per run to .ai/backups/<timestamp>/
  - Creates .ai/PROJECT.md only when it does not already exist
  - Re-running updates only managed blocks
  - Keeps going when one adapter fails, then reports every failure
HELP
}

# --help needs nothing installed, so answer it before any other check.
case "${1:-}" in
  --help|-h)
    usage
    exit 0
    ;;
esac

require_runtime() {
  if [ ! -d "$RUNTIME_HOME" ]; then
    echo "ERROR: AI Engineering Runtime assets not found at:"
    echo "  $RUNTIME_HOME"
    echo "Run install-all.sh first."
    exit 1
  fi
  # shellcheck source=/dev/null
  source "$RUNTIME_HOME/lib.sh"
}

if git rev-parse --show-toplevel >/dev/null 2>&1; then
  PROJECT_ROOT="$(git rev-parse --show-toplevel)"
else
  PROJECT_ROOT="$PWD"
  echo "No Git repository detected; using current directory as project root:"
  echo "  $PROJECT_ROOT"
fi

# PID keeps two runs inside the same second from sharing (and silently skipping)
# a backup directory.
RUN_STAMP="$(date +%Y%m%d-%H%M%S)-$$"
BACKUP_DIR="$PROJECT_ROOT/.ai/backups/$RUN_STAMP"
FAILURES=""

begin_marker() { printf '<!-- BEGIN AI-ENGINEERING-RUNTIME PROJECT:%s -->' "$1"; }
end_marker() { printf '<!-- END AI-ENGINEERING-RUNTIME PROJECT:%s -->' "$1"; }

# Three adapters share AGENTS.md, so back it up once per run and only before the
# first merge touches it. A per-merge backup would capture a half-merged file.
backup_once() {
  target="$1"
  file="$2"

  if [ ! -f "$target" ]; then
    return 0
  fi
  if [ -f "$BACKUP_DIR/$file" ]; then
    return 0
  fi

  mkdir -p "$BACKUP_DIR"
  # Keep backups out of the user's repository without editing their .gitignore.
  if [ ! -f "$PROJECT_ROOT/.ai/backups/.gitignore" ]; then
    printf '*\n' > "$PROJECT_ROOT/.ai/backups/.gitignore"
  fi
  cp "$target" "$BACKUP_DIR/$file"
  echo "Backed up $file to: .ai/backups/$RUN_STAMP/$file"
}

merge_one() {
  name="$1"
  file="$2"
  marker="$3"
  target="$PROJECT_ROOT/$file"
  block="$RUNTIME_HOME/adapters/$name/PROJECT_BLOCK.md"

  backup_once "$target" "$file"

  if merge_managed_block "$target" \
    "$(begin_marker "$marker")" \
    "$(end_marker "$marker")" \
    "$block"; then
    echo "Merged $marker into: $file"
  else
    FAILURES="$FAILURES$file:$marker"$'\n'
  fi
}

remove_one() {
  file="$1"
  marker="$2"
  target="$PROJECT_ROOT/$file"

  backup_once "$target" "$file"

  if remove_managed_block "$target" \
    "$(begin_marker "$marker")" \
    "$(end_marker "$marker")"; then
    return 0
  fi
  FAILURES="$FAILURES$file:$marker"$'\n'
}

status_one() {
  name="$1"
  file="$2"
  marker="$3"
  target="$PROJECT_ROOT/$file"

  state="$(block_state_in "$target" "$(begin_marker "$marker")" "$(end_marker "$marker")")"

  if [ "$state" = "absent" ]; then
    printf "  %-7s %-11s not installed\n" "$marker" "$file"
    return 0
  fi

  if [ "$state" = "malformed" ]; then
    printf "  %-7s %-11s MALFORMED (fix the markers by hand, then re-run ai-init)\n" "$marker" "$file"
    return 0
  fi

  installed="$(block_version_in "$target" "$(begin_marker "$marker")" "$(end_marker "$marker")")"
  [ -n "$installed" ] || installed="0"

  available=""
  if [ -f "$RUNTIME_HOME/adapters/$name/PROJECT_BLOCK.md" ]; then
    available="$(block_version_in "$RUNTIME_HOME/adapters/$name/PROJECT_BLOCK.md" \
      "$(begin_marker "$marker")" "$(end_marker "$marker")")"
  fi

  if [ -z "$available" ]; then
    printf "  %-7s %-11s installed (v%s)\n" "$marker" "$file" "$installed"
  elif [ "$installed" = "$available" ]; then
    printf "  %-7s %-11s installed (v%s)\n" "$marker" "$file" "$installed"
  else
    printf "  %-7s %-11s OUTDATED (v%s installed, v%s available — re-run ai-init)\n" \
      "$marker" "$file" "$installed" "$available"
  fi
}

report_failures() {
  if [ -z "$FAILURES" ]; then
    return 0
  fi
  echo
  echo "ERROR: the following adapters were skipped:"
  printf '%s' "$FAILURES" | while IFS= read -r line; do
    if [ -n "$line" ]; then echo "  $line"; fi
  done
  echo
  echo "Fix the managed block markers in the files above, then re-run."
  exit 1
}

case "${1:-}" in
  --status)
    require_runtime
    echo "Project root: $PROJECT_ROOT"
    if [ -f "$PROJECT_ROOT/.ai/PROJECT.md" ]; then
      echo "PROJECT.md:   present"
    else
      echo "PROJECT.md:   missing"
    fi
    while IFS='|' read -r name file marker; do
      if [ -n "$name" ]; then status_one "$name" "$file" "$marker"; fi
    done <<< "$ADAPTERS"
    exit 0
    ;;
  --remove)
    require_runtime
    while IFS='|' read -r name file marker; do
      if [ -n "$name" ]; then remove_one "$file" "$marker"; fi
    done <<< "$ADAPTERS"
    report_failures
    echo "Removed managed project adapter blocks. .ai/PROJECT.md was preserved."
    exit 0
    ;;
  "")
    ;;
  *)
    echo "Unknown option: $1"
    usage
    exit 2
    ;;
esac

require_runtime

mkdir -p "$PROJECT_ROOT/.ai"

if [ ! -f "$PROJECT_ROOT/.ai/PROJECT.md" ]; then
  cp "$RUNTIME_HOME/templates/PROJECT.md" "$PROJECT_ROOT/.ai/PROJECT.md"
  echo "Created: $PROJECT_ROOT/.ai/PROJECT.md"
else
  echo "Kept existing: $PROJECT_ROOT/.ai/PROJECT.md"
fi

while IFS='|' read -r name file marker; do
  if [ -n "$name" ]; then merge_one "$name" "$file" "$marker"; fi
done <<< "$ADAPTERS"

report_failures

echo
echo "AI project context initialized:"
echo "  $PROJECT_ROOT"
echo
echo "Existing AGENTS.md / CLAUDE.md content was preserved."
echo
echo "For an existing project, next ask any coding agent:"
echo '請掃描目前 repository，依實際程式碼、README、設定檔與架構，完整填寫 .ai/PROJECT.md；不要修改其他程式碼。'
